---
import { sourceLinkLabel, archiveLinkLabel, KALLSTATUS_ETIKETT, type Kallstatus } from "../lib/source-link";

interface Props {
  quote: string;
  person: string | null;
  party: string;
  domain: string;
  date: string;
  sourceUrl: string;
  archiveUrl: string | null;
  kind?: "webb" | "tal";
  /** Källans skick vid senaste rötkontrollen. Odefinierad = aldrig kontrollerad. */
  sourceStatus?: Kallstatus;
}
const { quote, person, party, domain, date, sourceUrl, archiveUrl, kind, sourceStatus } = Astro.props;
const isTal = kind === "tal";
// En källa som ändrats eller tagits bort ska synas där citatet står, inte i en
// logg. Läsaren som klickar på källänken ska veta innan hen klickar att det är
// arkivkopian som bär citatet.
const kallstatus = sourceStatus ? KALLSTATUS_ETIKETT[sourceStatus] : null;
// Talat löfte länkar till filmen (tidsstämpel); webb/PDF får "källa (PDF, s. N)".
const sourceLabel = isTal ? "se i talet" : sourceLinkLabel(sourceUrl);
---
<blockquote>
  <p>{quote}</p>
</blockquote>
<div class="etikett citat-attribution">
  — {person || party}, {domain}, {date}
  {isTal && <> · <span class="tal-markor" title="Löftet är sagt i tal och kontrolleras mot en sparad textversion (se /metod)">talat löfte</span></>}
  {' '}· <a href={sourceUrl}>{sourceLabel}<span aria-hidden="true"> ↗</span></a>
  {archiveUrl && <> · <a href={archiveUrl}>{archiveLinkLabel(archiveUrl)}<span aria-hidden="true"> ↗</span></a></>}
</div>
{/* Stämpeln pekar vidare: den som ser att en källa ändrats ska kunna se VAD som
    ändrats, inte bara att något gjort det. Fallet står på /andrade-kallor när
    det har en arkivkopia och en människa öppnat båda länkarna. */}
{kallstatus && <div class="etikett etikett--sub kallstatus"><a href="/andrade-kallor">{kallstatus}</a></div>}

<style>
  .citat-attribution {
    margin-top: -0.5rem;
    margin-bottom: var(--mellanrum);
  }
  .tal-markor {
    font-variant: small-caps;
    letter-spacing: 0.02em;
    opacity: 0.85;
  }
</style>
