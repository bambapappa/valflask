---
import Layout from "../../layouts/Layout.astro";
import Lopsedel from "../../components/Lopsedel.astro";
import GapMatare from "../../components/GapMatare.astro";
import MetodLank from "../../components/MetodLank.astro";
import KallRad from "../../components/KallRad.astro";
import Dela from "../../components/Dela.astro";
import Loftesfilter from "../../components/Loftesfilter.astro";
import { getPromises, getParties, getConstants } from "../../lib/data";
import { formatMsek, formatMsekShort } from "../../lib/calc";
import { partyTotalMsek, getPromisesForParty, totalFlasket, categoryBreakdown, flasketPerRost, promiseNetMsek, groupBearersForParty, partyCoverage } from "../../lib/aggregates";
import { filtreraLoeften, filterNyckel, type Loeftesfilter } from "../../lib/loftesfilter";
import { getIssuesFile, getStances, cellFor, emptyCellText, statementById, POSITION_LABEL } from "../../lib/stances";

export function getStaticPaths() {
  return getParties().map((p) => ({ params: { kod: p.code } }));
}

const { kod } = Astro.params;
const promises = getPromises();
const parties = getParties();
const constants = getConstants();
const party = parties.find((p) => p.code === kod)!;
const promiseById = new Map(promises.map((p) => [p.id, p]));
const filters: Loeftesfilter[] = [
  { underlag: "parti", loftestyp: "reform" }, { underlag: "parti", loftestyp: "inriktning" }, { underlag: "parti", loftestyp: "alla" },
  { underlag: "utlovat", loftestyp: "reform" }, { underlag: "utlovat", loftestyp: "inriktning" }, { underlag: "utlovat", loftestyp: "alla" },
  { underlag: "alla", loftestyp: "reform" }, { underlag: "alla", loftestyp: "inriktning" }, { underlag: "alla", loftestyp: "alla" },
];
const views = filters.map((filter) => {
  const selected = filtreraLoeften(promises, filter);
  const partyPromises = getPromisesForParty(selected, kod!);
  const bearers = groupBearersForParty(selected, kod!);
  const promiseRows = partyPromises.map((p) => {
    const bearerId = p.group_id ? bearers.get(p.group_id) : undefined;
    const bearer = bearerId && bearerId !== p.id ? promiseById.get(bearerId) : undefined;
    return { p, bearer, underlag: p.cost.basis === "parti" ? "parti" : "utlovat" };
  });
  const tackning = partyCoverage(selected, kod!);
  return {
    key: filterNyckel(filter),
    count: partyPromises.length,
    total: partyTotalMsek(selected, kod!),
    perRost: flasketPerRost(partyTotalMsek(selected, kod!), party.votes_2022),
    flasket: totalFlasket(selected),
    categories: categoryBreakdown(partyPromises),
    promiseRows,
    tackning,
    andelEgna: tackning.antal > 0 ? Math.round((100 * tackning.egna) / tackning.antal) : 0,
    koncentrerat: tackning.topp3Andel >= 0.7,
  };
});
const defaultKey = "parti:reform";
const defaultView = views.find((view) => view.key === defaultKey)!;
const reformutrymme = constants.reformutrymme_msek_per_ar.value;
const canonicalPath = `/parti/${kod}`;
const issuesFile = getIssuesFile();
const stances = getStances();
const stanceRows = issuesFile.issues.flatMap((issue) =>
  issue.subquestions.map((sq) => {
    const cell = cellFor(stances, sq.id, kod!);
    const st = cell ? statementById(cell, cell.current.statement_id) : undefined;
    return { issue, sq, cell, st };
  }),
);
const pageTitle = `${party.name}s vallöften 2026 — utlovat.se`;
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Hem", "item": "https://utlovat.se/" },
    { "@type": "ListItem", "position": 2, "name": party.name, "item": `https://utlovat.se${canonicalPath}` },
  ],
}];
---
<Layout title={pageTitle} description={`Filtrera ${party.name}s vallöften 2026 efter partiets egna belopp, Utlovat.se:s beräkningar och löftestyp.`} ogImage={`/og/parti-${kod}.png`} jsonLd={jsonLd} canonicalPath={canonicalPath}>
  <div class="page-content">
    <div class="prosa-content prosa-content--centered"><h1>{party.name}</h1><p class="manifest-status">{party.manifest_2026}</p></div>
    <Loftesfilter count={defaultView.count} />
    <MetodLank />

    {views.map((view) => (
      <div data-loftesfilter-vy={view.key} data-loftesfilter-vy-antal={view.count} hidden={view.key !== defaultKey}>
        <Lopsedel total={formatMsek(view.total)} subtitle={party.name.toUpperCase()} count={view.count} date="2026" headingLevel="h2" partiBelopp={view.key.startsWith("parti:")} />

        <div class="prosa-content prosa-content--centered">
          <p><strong>{party.name}s</strong> valda löften väger <strong class:list={["num", "belopp", { partibelopp: view.key.startsWith("parti:") }]}>{formatMsekShort(view.total)} mdkr</strong> för de fyra åren 2027–2030, fördelat på {view.count} löften. Fläsk per röst: <strong class:list={["num", "belopp", { partibelopp: view.key.startsWith("parti:") }]}>{Math.round(view.perRost).toLocaleString("sv-SE")} kr</strong> ({party.mandate_2022} mandat, {party.votes_2022.toLocaleString("sv-SE")} röster 2022).</p>
        </div>

        <section class="sektion prosa-content prosa-content--centered underlag">
          <h2>Vad urvalet vilar på</h2>
          {view.tackning.antal > 0 ? <p>
            {view.tackning.antal} löften från {view.tackning.kallor} olika källor.
            <strong>{view.andelEgna} %</strong> av dem är hämtade från {party.name}s egna kanaler;{" "}
            {view.tackning.antal - view.tackning.egna === 0
              ? "inga kommer från medier eller riksdagens handlingar"
              : `${view.tackning.antal - view.tackning.egna} kommer från medier, riksdagens handlingar eller video`}.
            {view.tackning.senaste && <> Det senaste löftet är uttalat {view.tackning.senaste}.</>}
          </p> : <p>Det finns inga löften för detta urval.</p>}
          {view.koncentrerat && <p class="varning">De tre största löftena bär <strong>{Math.round(view.tackning.topp3Andel * 100)} %</strong> av summan, det största ensamt {Math.round(view.tackning.storstaAndel * 100)} %. Ett enskilt estimat väger alltså tungt här — läs uträkningarna bakom dem innan du jämför partier.</p>}
          <p class="notis">Urvalet gäller bara det partiet självt har lovat, med ordagrant citat och källa. Ett parti som publicerar mer material får därför fler löften här — det säger något om underlaget, inte om hur mycket partiet vill spendera.</p>
        </section>

        <GapMatare flasket={view.flasket} reformutrymme={reformutrymme} partiBelopp={view.key.startsWith("parti:")} />
        <p class="prosa-content totalscope">Mätaren gäller samtliga partiers löften i samma urval. Talen ovan gäller enbart {party.name}.</p>

        <section class="sektion">
          <h2>Kategorifördelning</h2>
          <div class="datavy datavy--scroll"><table><thead><tr><th class="radnr">#</th><th>Kategori</th><th class="num">Totalt (mdkr)</th><th class="num">Löften</th></tr></thead><tbody>
            {view.categories.map((cat, i) => <tr><td class="radnr">{i + 1}</td><td>{cat.category}</td><td class:list={["num", "belopp", { partibelopp: view.key.startsWith("parti:") }]}>{formatMsek(cat.totalMsek)}</td><td class="num">{cat.count}</td></tr>)}
          </tbody></table></div>
        </section>

        <section class="sektion">
          <h2>{party.name}:s löften</h2>
          <div class="datavy datavy--scroll"><table><thead><tr><th class="radnr">#</th><th>Löfte</th><th>Kategori</th><th>Typ</th><th>Beloppsunderlag</th><th class="num">Kostnad, minus för besparing</th><th>Status</th></tr></thead><tbody>
            {view.promiseRows.map(({ p, bearer, underlag }, i) => <tr><td class="radnr">{i + 1}</td><td><a href={`/lofte/${p.id}/${p.slug}`}>{p.title}</a></td><td>{p.category}</td><td>{p.loftestyp === "reform" ? "Reform" : "Inriktning/policy"}</td><td>{underlag === "parti" ? "Partiet" : "Utlovat.se"}</td><td class:list={["num", "belopp", { partibelopp: underlag === "parti" }]}>{bearer ? <span class="raknas">räknas en gång, i <a href={`/lofte/${bearer.id}/${bearer.slug}`}>{bearer.title}</a></span> : formatMsek(promiseNetMsek(p), p.cost.basis)}</td><td>{p.status}</td></tr>)}
          </tbody></table></div>
        </section>
      </div>
    ))}

    <section class="sektion" id="besked">
      <h2>Besked i de stora frågorna</h2>
      <p class="prosa-content beskednot">Ur <a href="/fragor">Frågevågen</a> — partiets senaste besked per delfråga, med ordagrant citat, källa och arkivkopia på frågesidan. Samma bevakning för alla åtta partier.</p>
      <div class="datavy datavy--scroll"><table><thead><tr><th>Fråga</th><th>Delfråga</th><th>Besked</th><th class="num">Datum</th></tr></thead><tbody>
        {stanceRows.map(({ issue, sq, cell, st }) => <tr><td><a href={`/fraga/${issue.slug}#${sq.id}-${kod}`}>{issue.title}</a></td><td>{sq.text}</td><td class="num beskedcell">{st ? POSITION_LABEL[cell!.current.position] : <span class="tomcell">{emptyCellText(cell?.last_searched ?? null)}</span>}</td><td class="num">{st?.date_stated ?? "—"}</td></tr>)}
      </tbody></table></div>
    </section>

    <KallRad source={`${party.name}:s valprogram`} />
    <Dela path={canonicalPath} title={pageTitle} text={`${party.name}s vallöften 2026 — källspårat på utlovat.se`} />
  </div>
</Layout>

<style>
  .raknas { font-family: var(--font-mono); font-size: var(--steg--1); color: var(--text-svag); white-space: normal; }
  .manifest-status { font-size: 0.85rem; color: var(--farg-text-svag, #666); font-style: italic; }
  .prosa-content--centered { margin: 1.5rem auto; }
  .underlag p { margin: 0 0 0.5rem; }
  .underlag .varning { border-left: 3px solid var(--linje); padding-left: 0.75rem; }
  .underlag .notis { color: var(--text-svag); font-size: var(--steg--1); }
  .totalscope { color: var(--text-svag); font-size: var(--steg--1); margin-top: 0.5rem; }
  .sektion { margin-top: 2rem; }
  .datavy--scroll { overflow-x: auto; }
  .beskednot { font-size: 0.9rem; color: var(--grafit); }
  .beskedcell { font-weight: 700; }
  .tomcell { font-weight: 400; color: var(--dis); }
</style>
