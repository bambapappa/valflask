---
import Layout from "../../layouts/Layout.astro";
import MetodLank from "../../components/MetodLank.astro";
import Dela from "../../components/Dela.astro";
import { getChronicles, getPromises, getConstants } from "../../lib/data";
import { totalFlasket, formatMsek } from "../../lib/calc";
import { escapeHtml, maskeraBelopp, maskeraText } from "../../lib/mask";
// Krönikornas platshållarmekanism bor i pipelinen och läses härifrån i
// stället för att kopieras — ett faktum har en plats, och två kopior av den
// här logiken skulle glida isär tyst. Modulen är ren textbehandling utan
// beroenden, så den går att läsa av båda paketen.
import { losUpp } from "../../../../pipeline/src/kronikans-tal.ts";
import { promiseNetMsek, isActive } from "../../lib/aggregates";

export function getStaticPaths() {
  const chronicles = getChronicles();
  return chronicles.map((c) => ({ params: { slug: c.slug }, props: { chronicle: c } }));
}

const { chronicle } = Astro.props;
const { slug } = Astro.params;
const [year, week] = slug.split("-");
const canonicalPath = `/veckans-flask/${slug}`;

// id → slug, för att göra [p-2026-XXXX] till länkar.
const slugById = new Map(getPromises().map((p) => [p.id, p.slug]));

/** Enkel rendering: stycken + [p-2026-XXXX] → länk till löftet. Texten escapas
 *  först, sedan maskas penningtalen (kostnadsgrinden), och till sist görs kända
 *  löftes-id om till länkar (inga andra HTML-taggar). */
function renderBody(md: string): string {
  return md
    .split(/\n{2,}/)
    .map((para) => {
      const html = maskeraBelopp(escapeHtml(para.trim())).replace(/\[(p-\d{4}-\d{4})\]/g, (m, id) => {
        const s = slugById.get(id);
        return s ? `<a href="/lofte/${id}/${s}">[${id}]</a>` : m;
      });
      return `<p>${html}</p>`;
    })
    .join("\n");
}

/**
 * Steg 1 ur beslutet 2026-08-09: talen slås upp när sidan byggs.
 *
 * Redogörelsen är statisk — vad veckan handlade om skrivs aldrig om. Summor,
 * gap och antal är däremot påståenden om datat, och ett påstående om datat ska
 * vara sant nu. De skrivs därför som platshållare i krönikans text och löses
 * upp här.
 *
 * De sex krönikor som skrevs före beslutet bär sina tal i löptexten och har
 * inga platshållare att lösa upp; för dem gör det här steget ingenting, och
 * «Då och nu»-rutan nedan gör skillnaden synlig i stället.
 */
const reformutrymmePerArTal = getConstants().reformutrymme_msek_per_ar.value;
const reformBudgetTal = typeof reformutrymmePerArTal === "number" ? reformutrymmePerArTal * 4 : 0;
const aktivaLoften = getPromises().filter(isActive);
const totaltNu = totalFlasket(aktivaLoften);
const { text: bodyMd, olosta } = losUpp(chronicle.body_md, {
  total_msek: totaltNu,
  gap_msek: Math.max(0, totaltNu - reformBudgetTal),
  antal_loften: aktivaLoften.length,
  belopp: Object.fromEntries(aktivaLoften.map((p) => [p.id, promiseNetMsek(p)])),
});
// En platshållare som inte gick att slå upp lämnas synlig i texten av
// `losUpp`, med flit. Bygget ska dessutom säga ifrån — en krönika som tappat
// ett tal är ett fel någon ska se, inte en text som tyst saknar en siffra.
for (const o of olosta) {
  console.warn(`Veckans fläsk ${chronicle.slug}: ${o.platshallare} gick inte att slå upp — ${o.skal}`);
}

const bodyHtml = renderBody(bodyMd);

/**
 * Då och nu — de sparade talen bredvid dagens.
 *
 * Regeln sedan 2026-08-09 är att redogörelsen är statisk och talen dynamiska:
 * texten skrivs aldrig om, men summor och antal slås upp när sidan byggs.
 * `total_msek` och `gap_msek` är vad som gällde veckan krönikan skrevs, och
 * rutan visar dem bredvid dagens så att en läsare ser att en siffra rört sig
 * — inte bara den nya. Rutan visas bara när talen faktiskt skiljer sig.
 *
 * För de sex krönikor som skrevs före beslutet bär löptexten fortfarande sina
 * tal, och då är rutan det enda som visar skillnaden.
 */
const promisesNu = getPromises();
const reformutrymmePerAr = getConstants().reformutrymme_msek_per_ar.value;
const reformBudget = typeof reformutrymmePerAr === "number" ? reformutrymmePerAr * 4 : null;
const flasketNu = totalFlasket(promisesNu);
const gapNu = reformBudget !== null ? Math.max(0, flasketNu - reformBudget) : null;
const visaDaOchNu = flasketNu !== chronicle.total_msek;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": chronicle.headline,
    "description": `Veckans fläsk, vecka ${week} ${year}: ${chronicle.headline}`,
    "url": `https://utlovat.se${canonicalPath}`,
    "datePublished": chronicle.generated_at,
    "author": { "@type": "Organization", "name": "utlovat.se" },
    "publisher": { "@type": "Organization", "name": "utlovat.se" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Hem", "item": "https://utlovat.se/" },
      { "@type": "ListItem", "position": 2, "name": `Vecka ${week}`, "item": `https://utlovat.se${canonicalPath}` },
    ],
  },
];
---
<Layout title={`Veckans fläsk v${week} ${year} — utlovat.se`} description={`Veckans fläsk, vecka ${week} ${year}: ${chronicle.headline}`} jsonLd={jsonLd} canonicalPath={canonicalPath}>
  <div class="page-content">
    <div class="prosa-content prosa-content--centered">
      <div class="etikett etikett--week">Veckans fläsk · Vecka {week} {year}</div>
      <h1 set:html={maskeraText(chronicle.headline)} />

      {chronicle.correction_note && (
        <aside class="rattelse-not">
          <div class="etikett num">RÄTTAD</div>
          <p><span set:html={maskeraText(chronicle.correction_note)} /> <a href="/rattelser">Rättelseloggen</a>.</p>
        </aside>
      )}

      <article class="kronika" set:html={bodyHtml} />

      {visaDaOchNu && (
        <aside class="da-och-nu">
          <div class="etikett num">DÅ OCH NU</div>
          <p>
            Redogörelsen ovan är den som skrevs vecka {week} och skrivs aldrig om.
            Siffrorna nedan är de som gällde då, bredvid dem som gäller nu.
          </p>
          <table class="da-och-nu__tabell">
            <thead>
              <tr><th scope="col">&nbsp;</th><th scope="col" class="num">I krönikan</th><th scope="col" class="num">I dag</th></tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Fläsket totalt</th>
                <td class="num belopp" set:html={maskeraText(formatMsek(chronicle.total_msek))} />
                <td class="num belopp" set:html={maskeraText(formatMsek(flasketNu))} />
              </tr>
              {gapNu !== null && (
                <tr>
                  <th scope="row">Finansieringsgap</th>
                  <td class="num belopp" set:html={maskeraText(formatMsek(chronicle.gap_msek))} />
                  <td class="num belopp" set:html={maskeraText(formatMsek(gapNu))} />
                </tr>
              )}
            </tbody>
          </table>
          <p class="da-och-nu__varfor">
            Talen skiljer sig när nya löften tillkommit, när samma politik från
            flera partier räknats ihop till ett löfte, eller när ett kostnadsestimat
            setts över. Vad som ändrats står i <a href="/rattelser">rättelseloggen</a>.
          </p>
        </aside>
      )}

      <MetodLank />

      <Dela path={canonicalPath} title={`Veckans fläsk v${week} ${year} — utlovat.se`} text={`${chronicle.headline} — Veckans fläsk på utlovat.se`} />
    </div>
  </div>
</Layout>

<style>
  .prosa-content--centered {
    margin: 0 auto;
  }
  .etikett--week {
    margin-bottom: 0.5rem;
  }
  .rattelse-not {
    border: 1px solid var(--svarta);
    border-left: 4px solid var(--svarta);
    padding: 0.75rem 1rem;
    margin: 1rem 0 1.5rem;
  }
  .rattelse-not p {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    color: var(--grafit);
  }
  .kronika :global(p) {
    margin: 0 0 1rem;
  }
  .da-och-nu {
    border: 1px solid var(--grafit);
    padding: 0.75rem 1rem 1rem;
    margin: 1.5rem 0;
  }
  .da-och-nu p {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    color: var(--grafit);
  }
  .da-och-nu__tabell {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.75rem;
  }
  .da-och-nu__tabell th,
  .da-och-nu__tabell td {
    text-align: left;
    padding: 0.35rem 0.5rem 0.35rem 0;
    border-bottom: 1px solid var(--dimma, #ddd);
    font-size: 0.95rem;
  }
  .da-och-nu__tabell .num {
    text-align: right;
    padding-right: 0;
  }
  .da-och-nu__tabell thead th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--grafit);
  }
  .da-och-nu__varfor {
    margin-top: 0.75rem;
  }
</style>
