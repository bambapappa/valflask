const talade = taladeKallorTal();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Hur räknar ni ut vad ett löfte kostar?",
