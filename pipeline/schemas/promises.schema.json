{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utlovat.se/schemas/promises.schema.json",
  "title": "Löften",
  "description": "Array av vallöften (§5.1). Varje post är ett kanoniskt löfte som committas av pipeline-boten.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "slug",
      "parties",
      "person",
      "quote",
      "date_stated",
      "source",
      "category",
      "cost",
      "financing_claimed",
      "comparisons",
      "quip",
      "status",
      "history",
      "extraction"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^p-\\d{4}-\\d{4}$"
      },
      "group_id": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^g-[a-z0-9-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 5,
        "maxLength": 160
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "parties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "enum": [
            "s",
            "m",
            "sd",
            "c",
            "v",
            "kd",
            "l",
            "mp"
          ]
        }
      },
      "person": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "role": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "riksdagen_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{1,20}$"
              }
            }
          }
        ]
      },
      "quote": {
        "type": "string",
        "minLength": 10,
        "maxLength": 600
      },
      "date_stated": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "domain",
          "archive_url",
          "fetched_at"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "archive_url": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^https://web\\.archive\\.org/"
              },
              {
                "type": "null"
              }
            ]
          },
          "fetched_at": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "webb",
              "tal"
            ]
          },
          "source_status": {
            "enum": [
              "ok",
              "andrad",
              "borttagen"
            ],
            "description": "Satt av pnpm promises:rot-check. 'andrad'/'borttagen' renderas med synlig stämpel på löftessidan — arkivkopian gäller. Frivilligt: en källa som aldrig öppnats igen saknar fältet."
          },
          "source_checked_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "transcript_url": {
            "description": "Adress till en avskrift läsaren själv kan öppna. Sätts bara när avskriften faktiskt är publik; en avskrift vi håller men inte publicerar hör hemma i transcript_held och ingen annanstans.",
            "oneOf": [{ "type": "string", "pattern": "^https://" }, { "type": "null" }]
          },
          "transcript_held": {
            "type": "object",
            "description": "Citatet är prövat mot en avskrift av sändningen som ligger i det privata bevisvalvet. Svagare än en arkivkopia, för läsaren kan inte öppna den — därför står det utskrivet på löftessidan i stället för att räknas som ett publikt belägg. Kontrollen görs om med pnpm avskrift:kontroll. Mänskligt beslut 2026-08-17; avskriften publiceras inte, se SPEC §6.2 och §17.",
            "additionalProperties": false,
            "required": ["video_id", "vault", "checked_at", "comparison"],
            "properties": {
              "video_id": {
                "type": "string",
                "minLength": 1,
                "description": "Filmens id hos värden, det som gör avskriften återfinningsbar i valvet."
              },
              "vault": {
                "type": "string",
                "minLength": 1,
                "description": "Valvfilen med repo och sökväg. Adressen går inte att öppna utan behörighet, och det är avsikten."
              },
              "checked_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "comparison": {
                "enum": ["strikt", "mjuk"],
                "description": "Hårdaste regeln citatet klarade. 'strikt' = tecken för tecken så när som på typografi. 'mjuk' = ASR-undantaget från 2026-06-29, som bortser från skiftläge och skiljetecken därför att maskinskriven text hör fel på just dem."
              }
            }
          },
          "source_change": {
            "type": "object",
            "description": "Vad som ändrats, inte bara att något ändrats. Mätvärden ur källan som den ser ut i dag, satta av pnpm promises:rot-check. Fallet visas på /andrade-kallor först när det har en arkivkopia OCH reviewed_at, som en människa sätter.",
            "additionalProperties": false,
            "required": ["kind", "observed_at"],
            "properties": {
              "kind": {
                "enum": ["ordalydelse", "sidan-utbytt", "sidan-borttagen"],
                "description": "'ordalydelse' = citatets ord är omskrivna men sidan är kvar. 'sidan-utbytt' = inget av citatet står kvar. 'sidan-borttagen' = adressen svarar 404/410."
              },
              "observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "now_reads": {
                "type": "string",
                "description": "Meningen som står där i dag, ordagrant ur källan. Aldrig omskriven. Saknas när sidan är utbytt eller borta."
              },
              "redirects_to": { "type": "string", "format": "uri" },
              "reviewed_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Datum då fallet kontrollerats mot BÅDA länkarna — den levande källan och arkivkopian — av någon som faktiskt öppnat dem. Sätts aldrig av svepet: det är hela poängen. Utan detta publiceras fallet inte, och sammanslagningen till main är därutöver en människas beslut."
              },
              "note": { "type": "string" }
            }
          }
        }
      },
      "category": {
        "enum": [
          "välfärd",
          "skatter",
          "försvar",
          "klimat-miljö",
          "rättsväsende",
          "utbildning",
          "infrastruktur",
          "migration",
          "övrigt"
        ]
      },
      "cost": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "period",
          "msek_low",
          "msek_base",
          "msek_high",
          "basis",
          "basis_url",
          "method_note",
          "confidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "utgift",
              "intäktsminskning",
              "besparing",
              "intäktsökning"
            ]
          },
          "period": {
            "enum": [
              "per_ar",
              "engang"
            ]
          },
          "msek_low": {
            "type": "number",
            "minimum": 0
          },
          "msek_base": {
            "type": "number",
            "minimum": 0
          },
          "msek_high": {
            "type": "number",
            "minimum": 0
          },
          "basis": {
            "enum": [
              "rut",
              "myndighet",
              "parti",
              "media",
              "llm_estimat",
              "granskare"
            ]
          },
          "basis_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "method_note": {
            "type": "string",
            "minLength": 1
          },
          "calculation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "financing_claimed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "described"
        ],
        "properties": {
          "described": {
            "type": "boolean"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "msek": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "period": {
            "type": "string",
            "enum": [
              "per_ar",
              "engang"
            ],
            "description": "Avser finansieringsbeloppet ett år eller hela mandatperioden? Krävs när msek är ett tal, för beloppet dras från kostnader räknade för perioden."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "msek": {
                  "type": "number"
                }
              },
              "required": [
                "msek"
              ]
            },
            "then": {
              "required": [
                "described",
                "period"
              ],
              "properties": {
                "described": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "comparisons": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "quip": {
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "enum": [
          "aktiv",
          "uppdaterad",
          "tillbakadragen",
          "infriad"
        ]
      },
      "history": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "change",
            "commit"
          ],
          "properties": {
            "date": {
              "type": "string"
            },
            "change": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            }
          }
        }
      },
      "extraction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "verified_by",
          "run_id"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "verified_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
