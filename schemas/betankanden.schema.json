{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "betankanden.json — index över utskottsbetänkanden (voteringars källtexter)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["dok_id", "rm", "beteckning", "datum", "titel"],
    "additionalProperties": false,
    "properties": {
      "dok_id": { "type": "string", "minLength": 1 },
      "rm": { "type": "string", "pattern": "^\\d{4}/\\d{2}$" },
      "beteckning": { "type": "string", "minLength": 1 },
      "datum": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "titel": { "type": "string" },
      "organ": { "type": "string" }
    }
  }
}
