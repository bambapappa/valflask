---
/**
 * Ämnessök och ordtrender (b-0014). Två delar:
 *
 *  1. Fritextsök över alla riksdagshandlingar i registret. Indexet SÖKER —
 *     det dömer aldrig. Riktning ("stödjer/motverkar") visas bara på de
 *     handlingar som burit ett granskat utslag.
 *  2. Ordtrender: vilka ord varje parti använder mer än de andra. Partiernas
 *     egna ord, räknade — ingen tolkning.
 */
import Layout from "../layouts/Layout.astro";
import Rattelsenot from "../components/Rattelsenot.astro";
import { byggPartiTrender, forkortningarIIndexet, indexFinns, ordSkarvor, voteringSkarvor } from "../lib/amne.ts";
import { getParties, rattelserForPath } from "../lib/data.ts";
import { PARTIBITAR } from "../lib/delat.ts";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const finns = indexFinns();
const trender = finns ? byggPartiTrender() : [];
const skarvnycklar = finns ? ordSkarvor() : [];
const rostskarvor = finns ? voteringSkarvor() : [];
const partier = getParties()
  .filter((p) => PARTIBITAR.includes(p.code))
  .sort((a, b) => a.code.localeCompare(b.code, "sv"));
const forkortningar = finns && forkortningarIIndexet();
// Skalan är PARTIETS EGEN, inte en global. Med ett gemensamt tak satte ett
// enda partis extremord skalan för alla åtta: Liberalernas arton staplar låg
// mellan 2 % och 4 % av bredden och gick inte att skilja åt, Miljöpartiets
// mellan 5 % och 20 %. Bara det parti som råkade äga toppvärdet fick använda
// hela bredden. Nu spänner varje lista över sin egen bredd, och staplarna
// jämförs därför INOM ett parti — aldrig mellan två. Det står i noten intill.
const partiMax = new Map(
  trender.map((t) => [t.kod, Math.max(0.0001, ...t.ord.map((o) => o.vikt))]),
);
// Talet är både procent och x-koordinat: stapeln ritas i en svg vars viewBox
// är hundra enheter bred, så "36" betyder 36 % av spåret utan omräkning.
const andel = (kod: string, vikt: number): number =>
  Math.max(2, Math.min(100, Math.round((vikt / (partiMax.get(kod) ?? 1)) * 100)));
---
<Layout title="Ämnen och ord — Handlingsvågen" canonicalPath="/amnen">
  <div class="prosa">
    <h1>Ämnen och ord</h1>
    <Rattelsenot rattelser={rattelserForPath("/amnen")} />
    <p class="ingress">
      Sök bland allt partierna skrivit i riksdagen: förslag de lämnat in,
      frågor de ställt till ministrarna, och regeringens egna lagförslag.
      Längre ner står också vilka ord som skiljer partierna åt.
    </p>

    {!finns && (
      <p class="tomt">
        Sökregistret är inte färdigbyggt ännu. Sidan fylls när det är klart.
        Så länge visar vi hellre ingenting än halva svar.
      </p>
    )}

    {finns && (
      <>
        <h2>Sök ett ämne</h2>
        <p class="hjalp">
          Skriv ett ord, till exempel <i>kärnkraft</i>, <i>vårdplatser</i>
          eller <i>tandvård</i>. Du behöver inte träffa rätt form av ordet:
          <i>skolor</i> och <i>skolan</i> ger samma träffar som <i>skola</i>.
          {forkortningar && (
            <> Förkortningar fungerar också — <i>NPF</i>, <i>LSS</i>, <i>CSN</i>.</>
          )}
          Skriver du flera ord visas bara dokument som innehåller alla.
        </p>

        <div
          class="amnesok"
          data-bas={base}
          data-skarvor={skarvnycklar.join(" ")}
          data-rostskarvor={rostskarvor.join(" ")}
        >
          <label class="hoppa" for="amne-falt">Sök ord bland riksdagens handlingar</label>
          <input
            id="amne-falt"
            type="search"
            placeholder="Sök ord — kärnkraft, vårdplatser, tandvård…"
            autocomplete="off"
          />

          <fieldset class="partifilter">
            <legend>Visa bara handlingar från</legend>
            <div class="partival">
              {partier.map((p) => (
                <label class="partikryss">
                  <input type="checkbox" name="parti" value={p.code} />
                  <span>{p.namn}</span>
                </label>
              ))}
            </div>
            <p class="hjalp filterhjalp">
              Kryssar du inte i något visas alla partier. Filtret gäller alla
              träffar, inte bara de som syns just nu.
            </p>
          </fieldset>

          <p id="amne-status" class="status" role="status" aria-live="polite"></p>
          <ul id="amne-traffar" class="traffar"></ul>
          <p id="amne-mer" class="status"></p>

          <section id="amne-roster" class="roster" hidden>
            <h3>Så röstade partierna i omröstningar om ämnet</h3>
            <p id="amne-roster-om" class="hjalp"></p>
            <div class="rosttabell-yta">
              <table class="rosttabell">
                <thead>
                  <tr>
                    <th scope="col">Parti</th>
                    <th scope="col">Ja</th>
                    <th scope="col">Nej</th>
                    <th scope="col">Avstod</th>
                    <th scope="col">Frånvarande</th>
                  </tr>
                </thead>
                <tbody id="amne-roster-rader"></tbody>
              </table>
            </div>
            <p class="hjalp">
              Läs det här försiktigt: <b>ja</b> betyder att partiet röstade för
              det förslag som låg på bordet — inte att partiet är för ämnet.
              Gällde omröstningen att <i>avslå</i> ett förslag om kärnkraft, då
              är ett ja en röst mot kärnkraft. Vad som stod på bordet framgår av
              utskottets text, som är länkad vid varje omröstning.
              Röstsiffrorna är riksdagens egna.
            </p>
            <ul id="amne-voteringar" class="voteringar"></ul>
          </section>
        </div>

        <h2>Ord som skiljer partierna åt</h2>
        <p class="hjalp">
          Här står inte de ord ett parti använder <i>mest</i> — då skulle alla
          åtta listor se likadana ut, för alla skriver ofta om skola och vård.
          Här står de ord partiet använder <b>oftare än de sju andra gör</b>.
        </p>
        <p class="hjalp">
          Så räknas det: vi tar andelen av partiets egna dokument där ordet
          står, och jämför den med andelen hos alla andra partier tillsammans.
          Är andelen mycket större hamnar ordet högt i listan. Ett ord kan
          alltså komma med trots att det bara står i en handfull dokument —
          om nästan ingen annan skriver det.
        </p>
        <p class="hjalp">
          <b>Stapeln</b> visar hur stor den skillnaden är, jämfört med
          <b>partiets eget mest utmärkande ord</b>. Den längsta stapeln i varje
          lista är alltså full — jämför staplar inom ett parti, aldrig mellan
          två. Måttet i sig står i stapelns beskrivning: hur många gånger
          oftare partiet skriver ordet än de andra tillsammans.
          <b>Talet till höger</b> är något annat: antalet av partiets egna
          dokument där ordet faktiskt står. Ett kort streck och ett högt tal
          betyder ett ord partiet skriver ofta men som de andra också gör.
        </p>
        <p class="hjalp">
          Det här är räknat, inte tolkat. Att ett ord står högt säger vad
          partiet skriver om — inte vad det tycker i frågan, och ingenting om
          något löfte. Ledamöternas förnamn är bortplockade: att ett parti
          ofta nämner en motståndare är inget ämne.
        </p>
        <p class="hjalp">
          Och alla ord är inte ämnen. Riksdagen har ett eget språk, fullt av
          ord som <i>avslå</i>, <i>återkomma</i> och <i>övervägas</i>. Vi
          rensar bort det vi hittar, men en del tar sig igenom — och ett parti
          som skriver många förslag av en viss sort får då sina vanor med i
          listan. Ser du ett sådant ord säger det mer om hur partiet skriver
          än om vad det driver.
        </p>

        <div class="trender">
          {trender.map((t) => (
            <section class="trend">
              <h3>
                <a href={`${base}parti/${t.kod}`}>{t.namn}</a>
                <span class="antal">{t.handlingar.toLocaleString("sv-SE")} dokument totalt</span>
              </h3>
              {t.ord.length === 0 ? (
                <p class="tomt">För få dokument från partiet för att kunna räkna på ännu.</p>
              ) : (
                <ul class="ordlista">
                  {t.ord.map((o) => (
                    <li>
                      <span class="ord">{o.ord}</span>
                      <span
                        class="stapel"
                        title={`Använder ordet ${o.vikt.toFixed(1)} gånger så ofta som de andra partierna, räknat på andel av dokumenten`}
                      >
                        <svg viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                          <rect class="spar" width="100" height="8"></rect>
                          <rect class="fyll" width={andel(t.kod, o.vikt)} height="8"></rect>
                        </svg>
                      </span>
                      <span class="ordtal" title="Antal av partiets egna dokument där ordet står">
                        {o.antal.toLocaleString("sv-SE")}
                        <span class="hoppa"> dokument</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>

        <h2>Vad en träff betyder — och inte betyder</h2>
        <p>
          En träff betyder en enda sak: ordet står i dokumentets text. Den
          säger ingenting om partiet är för eller emot. Ett parti kan skriva
          om kärnkraft för att det vill bygga ut den, och ett annat för att
          det vill avveckla den — båda hamnar i samma träfflista.
        </p>
        <p>
          Vill du veta vad partiet <i>ville</i> får du läsa dokumentet; länken
          går till riksdagens egen sida. På de träffar där någon hos oss läst
          dokumentet och vägt det mot ett löfte står det utskrivet vid
          träffen. På övriga står ingenting, och då är det för att ingen vägt
          dem — inte för att svaret vore oklart.
        </p>
      </>
    )}
  </div>
</Layout>

{finns && (
  <script>
    // Buntas av Astro, så den kan använda SAMMA stamning som indexbygget.
    // Duplicerad stamningslogik skulle tyst börja gå isär med indexet.
    import { sokStammar } from "../../../pipeline/src/nyckelord.ts";
    import { PARTIBITAR, partiStandpunkt, STANDPUNKT_TEXT } from "../lib/delat.ts";
    import type { Roster, Standpunkt } from "../lib/delat.ts";

    const rot = document.querySelector<HTMLElement>(".amnesok");
    const falt = document.querySelector<HTMLInputElement>("#amne-falt");
    const status = document.querySelector<HTMLElement>("#amne-status");
    const traffar = document.querySelector<HTMLElement>("#amne-traffar");
    const mer = document.querySelector<HTMLElement>("#amne-mer");
    const rosterYta = document.querySelector<HTMLElement>("#amne-roster");
    const rosterOm = document.querySelector<HTMLElement>("#amne-roster-om");
    const rosterRader = document.querySelector<HTMLElement>("#amne-roster-rader");
    const voteringslista = document.querySelector<HTMLElement>("#amne-voteringar");
    const partikryss = [...document.querySelectorAll<HTMLInputElement>('input[name="parti"]')];

    if (rot && falt && status && traffar && mer && rosterYta && rosterOm && rosterRader && voteringslista) {
      const bas = rot.dataset.bas ?? "/";
      // Vilka skärvor som faktiskt finns — sparar en bomhämtning per okänt
      // sökord (och därmed ett 404 i konsolen).
      const finnsSkarva = new Set((rot.dataset.skarvor ?? "").split(" ").filter(Boolean));
      const finnsRostskarva = new Set((rot.dataset.rostskarvor ?? "").split(" ").filter(Boolean));
      const MAX_TRAFFAR = 60;
      const MAX_VOTERINGAR = 12;
      const cache = new Map<string, unknown>();
      let vagda: Record<string, { riktning: string; lofte: string }> | null = null;
      let korning = 0;

      interface OrdPost {
        n: number;
        i: (number | string)[];
        p: string;
        bn: number;
        b: string[];
      }
      interface OrdSkarva { pre: string; bredd: number; o: Record<string, OrdPost> }
      interface VoteringKort { p: number; d: string; u: string; url: string; r: Record<string, Roster> }
      interface BetankandeKort { t: string; o: string; d: string; v: VoteringKort[] }

      async function hamta<T>(url: string): Promise<T | null> {
        if (cache.has(url)) return cache.get(url) as T;
        try {
          const svar = await fetch(url);
          if (!svar.ok) return null;
          const data = (await svar.json()) as T;
          cache.set(url, data);
          return data;
        } catch {
          return null;
        }
      }

      const SORT: Record<string, string> = {
        motion: "motion",
        proposition: "proposition",
        interpellation: "interpellation",
        skriftlig_fraga: "skriftlig fråga",
        votering: "votering",
      };

      const tal = (n: number) => n.toLocaleString("sv-SE");

      /** De ikryssade partierna som bitmask. Noll betyder "alla partier". */
      function valdMask(): number {
        let mask = 0;
        for (const kryss of partikryss) {
          if (!kryss.checked) continue;
          const bit = PARTIBITAR.indexOf(kryss.value);
          if (bit >= 0) mask |= 1 << bit;
        }
        return mask;
      }

      function valdaNamn(): string[] {
        return partikryss
          .filter((k) => k.checked)
          .map((k) => k.parentElement?.querySelector("span")?.textContent ?? k.value);
      }

      /**
       * Sökorden, vart och ett med de stammar det ska slås upp på. Bestämd
       * form och grundform hamnar inte alltid på samma stam ("skolan" och
       * "skola"), så ett ord kan ge flera stammar. De slås ihop till EN
       * träfflista för ordet — läsaren ska inte behöva gissa vilken form
       * registret vill ha.
       */
      function sokord(text: string): { ord: string; stammar: string[] }[] {
        const ord = [...new Set(
          // Två tecken, inte tre: förkortningar indexeras från den längden,
          // och EU ska gå att söka på.
          text.toLowerCase().split(/[^a-zåäöéü0-9-]+/u).filter((w) => w.length >= 2),
        )];
        return ord.map((o) => ({ ord: o, stammar: sokStammar(o) }));
      }

      function handlingSkarva(id: string): string {
        const m = id.match(/^h-\d{4}-(\d+)$/u);
        return m ? String(Math.floor(Number(m[1]) / 1000)).padStart(2, "0") : "ovrigt";
      }

      function tomtResultat() {
        traffar.replaceChildren();
        mer.textContent = "";
        rosterYta.hidden = true;
        rosterRader.replaceChildren();
        voteringslista.replaceChildren();
      }

      async function sok(fraga: string) {
        const min = ++korning;
        const orden = sokord(fraga);
        tomtResultat();
        if (orden.length === 0) {
          status.textContent = "";
          return;
        }
        status.textContent = "Söker…";
        const flera = orden.length > 1 ? "alla orden" : "ordet";

        // Ett ord i taget: slå ihop ordets egna former, och skär sedan
        // snittet mellan orden — flera ord smalnar av träffen i stället
        // för att bredda den.
        let ids: string[] | null = null;
        let betIds: string[] | null = null;
        const masker = new Map<string, number>();
        let helaAntalet = 0;
        let helaBetAntalet = 0;
        let kapat = false;
        let betKapat = false;
        // Sant när ett ords träffar kommer från flera stammar: då vet vi
        // bara ett undre tak för hela antalet, aldrig det exakta.
        let underTak = false;
        for (const { stammar } of orden) {
          const union = new Set<string>();
          const betUnion = new Set<string>();
          let antal = 0;
          let betAntal = 0;
          let traffadeStammar = 0;
          for (const stam of stammar) {
            const nyckel = stam.slice(0, 2) || "_";
            const skarva = finnsSkarva.has(nyckel)
              ? await hamta<OrdSkarva>(`${bas}api/hv/amne/${encodeURIComponent(nyckel)}.json`)
              : null;
            const post = skarva?.o?.[stam];
            if (!post || !skarva) continue;
            traffadeStammar += 1;
            if (post.n > post.i.length) kapat = true;
            if (post.bn > post.b.length) betKapat = true;
            // Unionen är minst den största delmängden, högst summan — vi
            // har bara antalen, så vi håller oss till det vi vet.
            antal = Math.max(antal, post.n);
            betAntal = Math.max(betAntal, post.bn);
            post.i.forEach((kort, k) => {
              // Id:na kommer förkortade till sitt löpnummer. Nollfyllningen
              // MÅSTE tillbaka — `h-2026-868` är en annan handling än
              // `h-2026-0868`.
              const id = typeof kort === "number"
                ? `${skarva.pre}${String(kort).padStart(skarva.bredd, "0")}`
                : kort;
              union.add(id);
              // Partierna ligger i ordskärvan just för att filtret ska
              // kunna gallra FÖRE listan kapas — annars vore antalet en lögn.
              masker.set(id, Number.parseInt(post.p.slice(k * 2, k * 2 + 2), 16) || 0);
            });
            for (const b of post.b) betUnion.add(b);
          }
          if (traffadeStammar > 1) underTak = true;
          helaAntalet = ids === null ? antal : Math.min(helaAntalet, antal);
          helaBetAntalet = betIds === null ? betAntal : Math.min(helaBetAntalet, betAntal);
          ids = ids === null ? [...union].sort().reverse() : ids.filter((id) => union.has(id));
          betIds = betIds === null
            ? [...betUnion].sort().reverse()
            : betIds.filter((id) => betUnion.has(id));
          if (ids.length === 0 && betIds.length === 0) break;
        }
        if (min !== korning) return; // en nyare sökning har hunnit före

        const mask = valdMask();
        const funna = ids ?? [];
        // Filtret gäller HELA listan, inte bara de sextio som visas.
        const alla = mask === 0 ? funna : funna.filter((id) => ((masker.get(id) ?? 0) & mask) !== 0);

        void visaRoster(betIds ?? [], helaBetAntalet, betKapat, min);

        if (alla.length === 0) {
          status.textContent = mask === 0
            ? `Inga handlingar innehåller ${flera}.`
            : `Inga handlingar från ${valdaNamn().join(", ")} innehåller ${flera}.`;
          return;
        }

        const visade = alla.slice(0, MAX_TRAFFAR);
        const skarvor = [...new Set(visade.map(handlingSkarva))];
        const kort: Record<string, any> = {};
        for (const s of skarvor) {
          const del = await hamta<Record<string, any>>(`${bas}api/hv/handling/${s}.json`);
          Object.assign(kort, del ?? {});
        }
        vagda ??= (await hamta<Record<string, { riktning: string; lofte: string }>>(`${bas}api/hv/vagda.json`)) ?? {};
        if (min !== korning) return;

        // Vad vi kan stå för beror på om listan kapats och om ett filter är
        // på. Med filter känner vi bara partierna för de handlingar
        // registret levererat — då redovisas det, aldrig ett antal vi
        // inte har täckning för.
        if (mask === 0) {
          // Utan kapning är listan komplett och antalet exakt. Med kapning
          // redovisas det antal vi kan stå för — "minst" när flera former av
          // samma ord slagits ihop och unionen inte går att räkna exakt.
          const rubrik = kapat
            ? `${underTak ? "Minst " : ""}${tal(helaAntalet)} handlingar innehåller ${flera}.`
            : `${tal(alla.length)} handlingar innehåller ${flera}.`;
          status.textContent = kapat
            ? `${rubrik} Registret levererar de ${tal(funna.length)} senaste.`
            : rubrik;
        } else {
          const vilka = valdaNamn().join(", ");
          status.textContent = kapat
            ? `${tal(alla.length)} av de ${tal(funna.length)} senaste handlingarna som innehåller ${flera} är från ${vilka}. Totalt innehåller ${flera} ${underTak ? "minst " : ""}${tal(helaAntalet)} handlingar.`
            : `${tal(alla.length)} av ${tal(funna.length)} handlingar som innehåller ${flera} är från ${vilka}.`;
        }

        const poster = visade
          .map((id) => ({ id, k: kort[id] }))
          .filter((x) => x.k)
          .sort((a, b) => String(b.k.d).localeCompare(String(a.k.d)));

        for (const { id, k } of poster) {
          const li = document.createElement("li");
          const rad = document.createElement("div");
          rad.className = "rad1";

          const a = document.createElement("a");
          a.className = "titel";
          a.href = k.u;
          a.rel = "noopener";
          a.textContent = k.t;
          rad.append(a);

          const meta = document.createElement("span");
          meta.className = "meta";
          meta.textContent = `${SORT[k.k] ?? k.k} · ${k.d}${k.o ? " · " + k.o : ""}`;
          rad.append(meta);

          if (Array.isArray(k.p) && k.p.length > 0) {
            const pw = document.createElement("span");
            pw.className = "partier";
            for (const kod of k.p) {
              const pk = document.createElement("span");
              pk.className = "pk";
              pk.textContent = kod;
              pw.append(pk);
            }
            rad.append(pw);
          }

          li.append(rad);

          // Riktning visas BARA där ett utslag faktiskt vägts. Att ordet
          // står i texten säger ingenting om för eller emot.
          const v = vagda?.[id];
          if (v) {
            const u = document.createElement("div");
            u.className = "utslag";
            u.textContent = v.riktning === "stodjer"
              ? "Vägd: stödjer ett löfte"
              : "Vägd: motverkar ett löfte";
            li.append(u);
          }
          traffar.append(li);
        }
        if (alla.length > visade.length) {
          mer.textContent = `Visar de ${visade.length} senaste av ${tal(alla.length)}.`;
        }
      }

      /**
       * Röstsammanställningen: hur partierna röstade i de omröstningar som
       * hölls om betänkanden där ordet står.
       *
       * Detta är en HELT annan sak än träfflistan ovan, och de får aldrig
       * blandas ihop: att ett ord står i en text betyder att ämnet är
       * berört, medan en röst är något partiet faktiskt gjorde. Därför står
       * siffrorna för sig, med riksdagens egna tal.
       */
      async function visaRoster(betIds: string[], helaAntalet: number, kapat: boolean, min: number) {
        if (betIds.length === 0) return;
        const skarvor = [...new Set(betIds.map((id) => id.split(":")[0] ?? ""))];
        const betankanden: Record<string, BetankandeKort> = {};
        for (const s of skarvor) {
          if (!finnsRostskarva.has(s)) continue;
          const del = await hamta<Record<string, BetankandeKort>>(
            `${bas}api/hv/votering/${encodeURIComponent(s)}.json`,
          );
          Object.assign(betankanden, del ?? {});
        }
        if (min !== korning) return;

        // Ett betänkande utan votering har inget röstresultat att visa.
        const traffade = betIds.filter((id) => betankanden[id]);
        if (traffade.length === 0) return;

        const summa = new Map<string, Record<Standpunkt, number>>();
        const rader: { nyckel: string; bet: BetankandeKort; v: VoteringKort }[] = [];
        let antalVoteringar = 0;
        for (const nyckel of traffade) {
          const bet = betankanden[nyckel]!;
          for (const v of bet.v) {
            antalVoteringar += 1;
            rader.push({ nyckel, bet, v });
            for (const [parti, r] of Object.entries(v.r)) {
              const post = summa.get(parti) ?? { ja: 0, nej: 0, avstar: 0, franvarande: 0 };
              post[partiStandpunkt(r).val] += 1;
              summa.set(parti, post);
            }
          }
        }
        if (antalVoteringar === 0) return;

        rosterOm.textContent = kapat
          ? `Räknat på ${tal(antalVoteringar)} omröstningar i de ${tal(traffade.length)} senaste betänkandena som nämner ordet — av ${tal(helaAntalet)} betänkanden totalt.`
          : `Räknat på ${tal(antalVoteringar)} omröstningar i ${tal(traffade.length)} betänkanden som nämner ordet.`;

        rosterRader.replaceChildren();
        const mask = valdMask();
        for (const parti of PARTIBITAR) {
          const post = summa.get(parti);
          if (!post) continue;
          const bit = PARTIBITAR.indexOf(parti);
          const tr = document.createElement("tr");
          if (mask !== 0 && (mask & (1 << bit)) !== 0) tr.className = "vald";
          const namn = document.createElement("th");
          namn.scope = "row";
          namn.textContent = parti.toUpperCase();
          tr.append(namn);
          for (const val of ["ja", "nej", "avstar", "franvarande"] as Standpunkt[]) {
            const td = document.createElement("td");
            td.textContent = tal(post[val]);
            tr.append(td);
          }
          rosterRader.append(tr);
        }

        voteringslista.replaceChildren();
        rader.sort((a, b) => b.v.d.localeCompare(a.v.d) || a.v.p - b.v.p);
        for (const { bet, v } of rader.slice(0, MAX_VOTERINGAR)) {
          const li = document.createElement("li");
          const rad = document.createElement("div");
          rad.className = "rad1";
          const a = document.createElement("a");
          a.className = "titel";
          a.href = v.url;
          a.rel = "noopener";
          a.textContent = bet.t;
          rad.append(a);
          const meta = document.createElement("span");
          meta.className = "meta";
          meta.textContent = `punkt ${v.p} · ${v.d}${bet.o ? " · " + bet.o : ""} · ${v.u}`;
          rad.append(meta);
          li.append(rad);

          const stand = document.createElement("div");
          stand.className = "standpunkter";
          for (const parti of PARTIBITAR) {
            const r = v.r[parti];
            if (!r) continue;
            const { val, delad } = partiStandpunkt(r);
            const chip = document.createElement("span");
            chip.className = `stand ${val}`;
            chip.textContent = `${parti.toUpperCase()} ${STANDPUNKT_TEXT[val].toLowerCase()}${delad ? " (delat)" : ""}`;
            chip.title = `${r[0]} ja, ${r[1]} nej, ${r[2]} avstod, ${r[3]} frånvarande`;
            stand.append(chip);
          }
          li.append(stand);
          voteringslista.append(li);
        }
        if (rader.length > MAX_VOTERINGAR) {
          const li = document.createElement("li");
          li.className = "flerrad";
          li.textContent = `Visar de ${MAX_VOTERINGAR} senaste av ${tal(rader.length)} omröstningar.`;
          voteringslista.append(li);
        }
        rosterYta.hidden = false;
      }

      let timer: number | undefined;
      falt.addEventListener("input", () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => void sok(falt.value), 200);
      });
      // Filtret ska verka direkt — annars visar listan ett urval som inte
      // stämmer med kryssen.
      for (const kryss of partikryss) {
        kryss.addEventListener("change", () => void sok(falt.value));
      }
    }
  </script>
)}

<style>
