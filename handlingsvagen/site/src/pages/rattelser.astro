---
import Layout from "../layouts/Layout.astro";
import { getRattelser } from "../lib/data.ts";

const rattelser = [...getRattelser()].sort((a, b) => (a.date < b.date ? 1 : -1));
---
<Layout title="Rättelser — Handlingsvågen" canonicalPath="/rattelser">
  <div class="prosa">
    <h1>Rättelser</h1>
    <p class="ingress">
      Vi rättar fel öppet, aldrig i tysthet. Varje ändring lämnar ett spår som
      vem som helst kan läsa. Det är en av grundreglerna för hela sajten.
    </p>

    <h2>Så går en rättelse till</h2>
    <p>
      Hittar vi ett fel — i ett citat, i en koppling, i ett omdöme eller i en
      länk — rättar vi det och skriver ner vad som ändrades och varför. En not
      sätts på den sida som berörs, och ändringen hamnar i listan här nedanför
      med datum. Resten sköter sig själv: sidorna räknas fram ur underlaget, så
      när underlaget rättats stämmer de igen.
    </p>
    <p>
      Vem som helst får anmäla ett fel — partier, journalister, läsare. Vi
      kontrollerar varje anmälan mot riksdagens eget dokument, och mot vår
      sparade kopia av det när en sådan finns, innan vi rättar något.
    </p>

    <h2>Registrerade rättelser</h2>
    {rattelser.length === 0 ? (
      <p class="tom-not">Inga rättelser har registrerats ännu.</p>
    ) : (
      rattelser.map((r) => (
        <article class="rattelse">
          <div class="rubrik">{r.date} · {r.affects}</div>
          <p><strong>Vad:</strong> {r.what}</p>
          <p><strong>Varför:</strong> {r.why}</p>
        </article>
      ))
    )}
  </div>
</Layout>

<style>
  .prosa { max-width: 68ch; }
  .prosa h2 { margin-top: 1.8rem; font-size: 1.2rem; }
  .tom-not { color: var(--text-svag); font-style: italic; }
  .rattelse { border-top: 1px solid var(--linje); padding-top: 0.8rem; margin-top: 1rem; }
  .rattelse .rubrik { color: var(--text-svag); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; }
</style>
