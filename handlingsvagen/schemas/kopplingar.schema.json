{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kopplingar.json — kanter löfte/ståndpunkt ↔ handling (utkast HV0)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "handling_id", "riktning", "bevis", "method_note", "confidence", "status"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^k-\\d{4}-\\d{4}$" },
      "promise_id": { "type": "string", "pattern": "^p-\\d{4}-\\d{4}$" },
      "stance_id": { "type": "string" },
      "handling_id": { "type": "string", "pattern": "^h-\\d{4}-\\d{4,5}$" },
      "riktning": { "enum": ["stodjer", "motverkar"] },
      "bevis": {
        "type": "object",
        "required": ["citat"],
        "additionalProperties": false,
        "properties": {
          "citat": { "type": "string", "minLength": 20 },
          "sida": { "type": ["integer", "null"] },
          "kalla_dok_id": { "type": "string", "minLength": 1 }
        }
      },
      "motionstyp": { "enum": ["parti", "kommitte", "enskild"] },
      "method_note": { "type": "string" },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "extraction": {
        "type": "object",
        "required": ["model", "verified_by", "run_id"],
        "properties": {
          "model": { "type": "string" },
          "verified_by": { "type": ["string", "null"] },
          "run_id": { "type": "string" }
        }
      },
      "status": { "enum": ["aktiv", "indragen"] }
    },
    "oneOf": [
      { "required": ["promise_id"] },
      { "required": ["stance_id"] }
    ]
  }
}
